{
  "name": "my-fb-autopilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "check": "node --check api/scheduler/check-and-post.js && node --check lib/firebase-admin.js && node --check lib/facebook.js && node --check lib/gemini.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.5.0"
  },
  "devDependencies": {
    "vercel": "^48.0.0"
  }
}
